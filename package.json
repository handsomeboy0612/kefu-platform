{
  "name": "kefu-platform",
  "private": true,
  "version": "0.1.0",
  "description": "客服考核数据平台（内网网页版）：客服部 + 技术支持部",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "^2.75.0",
    "@douyinfe/semi-ui": "^2.75.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dayjs": "^1.11.13",
    "esbuild": "^0.24.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
